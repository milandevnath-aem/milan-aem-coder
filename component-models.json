  {
    "id": "emi-loan-type",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "title",
        "label": "Loan type",
        "value": ""
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "amount_min",
        "label": "Minimum loan amount (₹)",
        "required": true,
        "description": "Numbers only, e.g. 100000. Must not be more than the maximum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "amount_max",
        "label": "Maximum loan amount (₹)",
        "required": true,
        "description": "Numbers only, e.g. 10000000. Must not be less than the minimum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "amount_default",
        "label": "Default loan amount (₹)",
        "required": true,
        "description": "Starting value. Must be between the minimum and maximum, otherwise the nearest limit is used."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "amount_defaultError",
        "label": "⚠ Error: default loan amount must be between the minimum and maximum",
        "description": "Change the default, minimum or maximum. Until this is fixed, the calculator starts at the nearest limit.",
        "readOnly": true,
        "condition": {
          "or": [
            {
              "<": [
                {
                  "+": [
                    {
                      "var": "amount_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "amount_min"
                    }
                  ]
                }
              ]
            },
            {
              ">": [
                {
                  "+": [
                    {
                      "var": "amount_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "amount_max"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "amount_step",
        "label": "Slider step (₹)",
        "description": "How much one slider move changes the value, e.g. 10000. Must be more than 0 and no more than the range."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "rate_min",
        "label": "Minimum interest rate (%)",
        "required": true,
        "description": "Numbers only, e.g. 8. Must not be more than the maximum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "rate_max",
        "label": "Maximum interest rate (%)",
        "required": true,
        "description": "Numbers only, e.g. 24. Must not be less than the minimum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "rate_default",
        "label": "Default interest rate (%)",
        "required": true,
        "description": "Starting value. Must be between the minimum and maximum, otherwise the nearest limit is used."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "rate_defaultError",
        "label": "⚠ Error: default interest rate must be between the minimum and maximum",
        "description": "Change the default, minimum or maximum. Until this is fixed, the calculator starts at the nearest limit.",
        "readOnly": true,
        "condition": {
          "or": [
            {
              "<": [
                {
                  "+": [
                    {
                      "var": "rate_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "rate_min"
                    }
                  ]
                }
              ]
            },
            {
              ">": [
                {
                  "+": [
                    {
                      "var": "rate_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "rate_max"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "rate_step",
        "label": "Slider step (%)",
        "description": "How much one slider move changes the value, e.g. 0.1. Must be more than 0 and no more than the range."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_min",
        "label": "Minimum tenure (years)",
        "required": true,
        "description": "Numbers only, e.g. 1. Must not be more than the maximum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_max",
        "label": "Maximum tenure (years)",
        "required": true,
        "description": "Numbers only, e.g. 7. Must not be less than the minimum."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_default",
        "label": "Default tenure (years)",
        "required": true,
        "description": "Starting value. Must be between the minimum and maximum, otherwise the nearest limit is used."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_step",
        "label": "Slider step (years)",
        "description": "How much one slider move changes the value, e.g. 1. Must be more than 0 and no more than the range."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_minMonths",
        "label": "Minimum tenure (months)",
        "description": "Whole months, e.g. 12. Used when the customer switches the tenure to MO. Leave empty to use the minimum years × 12."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_maxMonths",
        "label": "Maximum tenure (months)",
        "description": "Whole months, e.g. 84. Must not be less than the minimum. Leave empty to use the maximum years × 12."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_stepMonths",
        "label": "Slider step (months)",
        "description": "How many months one slider move changes the value, e.g. 1 or 6. Leave empty for 1."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_defaultError",
        "label": "⚠ Error: default tenure must be between the minimum and maximum",
        "description": "Change the default, minimum or maximum. Until this is fixed, the calculator starts at the nearest limit.",
        "readOnly": true,
        "condition": {
          "or": [
            {
              "<": [
                {
                  "+": [
                    {
                      "var": "tenure_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "tenure_min"
                    }
                  ]
                }
              ]
            },
            {
              ">": [
                {
                  "+": [
                    {
                      "var": "tenure_default"
                    }
                  ]
                },
                {
                  "+": [
                    {
                      "var": "tenure_max"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "tenure_monthsError",
        "label": "⚠ Error: minimum months must not be more than maximum months",
        "description": "Change the minimum or maximum months. Until this is fixed, the calculator uses the minimum and maximum years × 12.",
        "readOnly": true,
        "condition": {
          ">": [
            {
              "+": [
                {
                  "var": "tenure_minMonths"
                }
              ]
            },
            {
              "+": [
                {
                  "var": "tenure_maxMonths"
                }
              ]
            }
          ]
        }
      }
    ]
  },
