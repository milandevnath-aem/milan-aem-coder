{
  "definitions": [
    {
      "title": "Section",
      "id": "section",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "model": "section"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "multiselect",
          "name": "style",
          "label": "Style",
          "options": [
            {
              "name": "Highlight",
              "value": "highlight"
            },
            {
              "name": "Brand (red, centered text)",
              "value": "brand"
            },
            {
              "name": "Brand (grey, centered text)",
              "value": "bg-grey"
            },
            {
              "name": "Animate text (banner text lights up on scroll)",
              "value": "animate-text"
            },
            {
              "name": "Padding top (124px desktop / 80px mobile)",
              "value": "padding-top"
            },
            {
              "name": "Padding bottom (124px desktop / 80px mobile)",
              "value": "padding-bottom"
            },
            {
              "name": "No margin top",
              "value": "no-margin-top"
            },
            {
              "name": "No margin bottom",
              "value": "no-margin-bottom"
            },
            {
              "name": "No margin top (mobile only)",
              "value": "no-margin-top-mobile"
            },
            {
              "name": "No margin top (desktop only)",
              "value": "no-margin-top-desktop"
            },
            {
              "name": "No margin bottom (mobile only)",
              "value": "no-margin-bottom-mobile"
            },
            {
              "name": "No margin bottom (desktop only)",
              "value": "no-margin-bottom-desktop"
            },
            {
              "name": "Background grey",
              "value": "sec-bg-grey"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "backgroundColor",
          "label": "Background color",
          "description": "Optional. A CSS color such as #eeeeee or rgb(238 238 238). Fills the whole section."
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "background",
          "label": "Background image (desktop)",
          "description": "Optional. Covers the whole section on desktop (and on mobile when no mobile image is set).",
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundMobile",
          "label": "Background image (mobile)",
          "description": "Optional. Used on small screens instead of the desktop image.",
          "multi": false
        }
      ]
    }
  ],
  "filters": [
    {
